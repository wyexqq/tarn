{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Tarn",
  "version": "0.1.0",
  "identifier": "dev.tarn.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1427",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Tarn",
        "width": 1100,
        "height": 740,
        "minWidth": 640,
        "minHeight": 480,
        "visible": false,
        "dragDropEnabled": true,
        "backgroundThrottling": "suspend"
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: http://widget.localhost widget:; frame-src http://widget.localhost widget:; font-src 'self'; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper" },
      "nsis": { "installMode": "currentUser" }
    }
  }
}
